@base_url = http://localhost:5103/api
@auth_url = http://localhost:5103/api/auth
@tickets_url = http://localhost:5103/api/tickets
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..ySi_C5XW8VULBO08r3-z2Lx9J9HcsA7Jh3IEOkIZi3g
#########################################
### STEP 1: LOGIN (REQUIRED FIRST)
#########################################

###
GET http://localhost:5103/api/debug/token
   Authorization: Bearer 

### Login to get JWT token
POST {{auth_url}}/login
Content-Type: application/json

{
  "email": "andrewchris0002@gmail.com",
  "password": "SecurePass456!"
}

# Response will include token in data.token
# Copy the token value and paste it in @token variable above

###

#########################################
### STEP 2: CREATE TICKETS
#########################################

### Create Ticket 1 - High Priority Bug
POST {{tickets_url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Login Page Not Working",
  "description": "Users cannot log into the system. Login button shows error 'Invalid credentials' even with correct password.",
  "category": "Bug",
  "priority": 3
}

# Priority: 1=Low, 2=Medium, 3=High, 4=Critical
# Save the ticket ID from response for later tests

###

### Create Ticket 2 - Medium Priority
POST {{tickets_url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Dashboard Performance Issue",
  "description": "Dashboard takes 30+ seconds to load. Need performance optimization.",
  "category": "Performance",
  "priority": 2
}

###

### Create Ticket 3 - Critical Priority
POST {{tickets_url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Database Connection Timeout",
  "description": "Production database connection failing. Multiple users affected. URGENT!",
  "category": "Critical",
  "priority": 4
}

###

### Create Ticket 4 - Low Priority
POST {{tickets_url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "UI Button Color Inconsistency",
  "description": "Some buttons have different colors. Please standardize all button colors.",
  "category": "UI",
  "priority": 1
}

###

#########################################
### STEP 3: GET TICKETS
#########################################

### Get All Tickets (Paginated)
GET {{tickets_url}}?pageNumber=1&pageSize=10
Authorization: Bearer {{token}}

# Returns all tickets with pagination

###

### Get All Tickets - Page 2 (if exists)
GET {{tickets_url}}?pageNumber=2&pageSize=5
Authorization: Bearer {{token}}

###

### Get Ticket by ID
### REPLACE {ticket-id} with actual ID from create response
GET {{tickets_url}}/{ticket-id}
Authorization: Bearer {{token}}

# Returns full ticket details with comments and activity log

###

#########################################
### STEP 4: GET TICKETS BY STATUS
#########################################

### Get All Open Tickets (Status = 1)
GET {{tickets_url}}/by-status/1?pageNumber=1&pageSize=10
Authorization: Bearer {{token}}

###

### Get All InProgress Tickets (Status = 2)
GET {{tickets_url}}/by-status/2?pageNumber=1&pageSize=10
Authorization: Bearer {{token}}

###

### Get All Resolved Tickets (Status = 3)
GET {{tickets_url}}/by-status/3?pageNumber=1&pageSize=10
Authorization: Bearer {{token}}

###

### Get All Reopened Tickets (Status = 4)
GET {{tickets_url}}/by-status/4?pageNumber=1&pageSize=10
Authorization: Bearer {{token}}

###

### Get All Closed Tickets (Status = 5)
GET {{tickets_url}}/by-status/5?pageNumber=1&pageSize=10
Authorization: Bearer {{token}}

###

#########################################
### STEP 5: GET MY TICKETS
#########################################

### Get My Created Tickets
GET {{tickets_url}}/my-tickets?pageNumber=1&pageSize=10
Authorization: Bearer {{token}}

# Returns only tickets you created

###

#########################################
### STEP 6: GET TICKETS ASSIGNED TO ME
#########################################

### Get Tickets Assigned To Me
GET {{tickets_url}}/assigned-to-me?pageNumber=1&pageSize=10
Authorization: Bearer {{token}}

# Returns tickets assigned to current user (excludes closed)

###

#########################################
### STEP 7: UPDATE TICKET
#########################################

### Update Ticket Title Only
### REPLACE {ticket-id} with actual ID
PUT {{tickets_url}}/{ticket-id}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Login Page Not Working - URGENT FIX REQUIRED"
}

###

### Update Ticket Description
PUT {{tickets_url}}/{ticket-id}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "description": "CRITICAL ISSUE: Multiple users unable to log into the system. This is blocking production access."
}

###

### Update Ticket Priority
PUT {{tickets_url}}/{ticket-id}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "priority": 4
}

###

### Update Ticket Category
PUT {{tickets_url}}/{ticket-id}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "category": "Critical Bug"
}

###

### Update Multiple Fields at Once
PUT {{tickets_url}}/{ticket-id}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Login Issue - System Down",
  "description": "Users cannot access the system. All login attempts failing.",
  "priority": 4,
  "category": "System Critical"
}

###

#########################################
### STEP 8: ASSIGN TICKET
#########################################

### Assign Ticket to Technician
### REPLACE {ticket-id} with ticket ID
### REPLACE {technician-id} with another user ID (create another user first if needed)
PATCH {{tickets_url}}/{ticket-id}/assign
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "assignedToUserId": "{technician-id}",
  "reason": "Assigned for immediate resolution"
}

###

#########################################
### STEP 9: CHANGE TICKET STATUS
#########################################

### Change Status to InProgress (2)
PATCH {{tickets_url}}/{ticket-id}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": 2,
  "reason": "Started investigating the issue"
}

###

### Change Status to Resolved (3)
PATCH {{tickets_url}}/{ticket-id}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": 3,
  "reason": "Issue has been fixed and tested"
}

###

### Change Status to Reopened (4)
PATCH {{tickets_url}}/{ticket-id}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": 4,
  "reason": "Customer reported issue still exists"
}

###

### Change Status to Closed (5)
PATCH {{tickets_url}}/{ticket-id}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": 5,
  "reason": "Confirmed resolved by customer"
}

###

#########################################
### STEP 10: CLOSE TICKET
#########################################

### Close Ticket (Alternative to status change)
DELETE {{tickets_url}}/{ticket-id}
Authorization: Bearer {{token}}

# Marks ticket as closed

###

#########################################
### STEP 11: ADD COMMENTS
#########################################

### Add Comment Without Attachment
POST {{tickets_url}}/{ticket-id}/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "comment": "I have started investigating this issue. Will provide updates within 2 hours.",
  "attachmentUrl": null
}

###

### Add Comment With Attachment URL
POST {{tickets_url}}/{ticket-id}/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "comment": "Found the root cause. See attached error log for details.",
  "attachmentUrl": "https://example.com/logs/error-log-2024-03-06.pdf"
}

###

### Add Resolution Comment
POST {{tickets_url}}/{ticket-id}/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "comment": "Issue resolved. Login functionality is now working correctly for all users. Please test and confirm.",
  "attachmentUrl": "https://example.com/fixes/deployment-summary.txt"
}

###

#########################################
### STEP 12: GET COMMENTS
#########################################

### Get All Comments for Ticket
GET {{tickets_url}}/{ticket-id}/comments
Authorization: Bearer {{token}}

# Returns all comments in reverse chronological order (newest first)

###

#########################################
### STEP 13: DELETE COMMENT
#########################################

### Delete Your Own Comment
### REPLACE {comment-id} with actual comment ID from get comments response
DELETE {{tickets_url}}/comments/{comment-id}
Authorization: Bearer {{token}}

# Only the comment author can delete their own comments

###

#########################################
### STEP 14: GET ACTIVITY LOG
#########################################

### Get Complete Ticket Activity Log
GET {{tickets_url}}/{ticket-id}/activity
Authorization: Bearer {{token}}

# Shows all changes: creation, updates, status changes, assignments, comments
# Each entry shows who changed it, what changed, old value, new value, and when

###

#########################################
### ERROR TESTING
#########################################

### Test 401: Request Without Authentication
POST {{tickets_url}}
Content-Type: application/json

{
  "title": "Test Ticket",
  "description": "This should fail without JWT token"
}

# Expected: 401 Unauthorized

###

### Test 400: Invalid Ticket Data (Title Too Short)
POST {{tickets_url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "AB",
  "description": "Description is ok but title is too short",
  "category": "Test",
  "priority": 2
}

# Expected: 400 Bad Request - Title must be at least 3 characters

###

### Test 400: Invalid Ticket Data (Description Too Short)
POST {{tickets_url}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "title": "Valid Title Here",
  "description": "Short",
  "category": "Test",
  "priority": 2
}

# Expected: 400 Bad Request - Description must be at least 10 characters

###

### Test 404: Get Non-existent Ticket
GET {{tickets_url}}/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

# Expected: 404 Not Found

###

### Test 400: Assign to Non-existent Technician
PATCH {{tickets_url}}/{ticket-id}/assign
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "assignedToUserId": "00000000-0000-0000-0000-000000000000"
}

# Expected: 400 Bad Request - Technician not found

###

### Test 400: Delete Non-existent Comment
DELETE {{tickets_url}}/comments/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{token}}

# Expected: 400 Bad Request - Comment not found

###

#########################################
### COMPLETE WORKFLOW TEST
#########################################

# RECOMMENDED TEST SEQUENCE:
#
# 1. Login → Get JWT token (copy to @token)
# 2. Create Ticket 1
# 3. Get All Tickets → See your ticket in list
# 4. Get Ticket by ID → See full ticket details
# 5. Update Ticket → Change title/description
# 6. Get My Tickets → See updated ticket
# 7. Add Comment 1 → Add your thoughts
# 8. Add Comment 2 → Add another comment
# 9. Get Comments → See all comments
# 10. Change Status → Open → InProgress
# 11. Change Status → InProgress → Resolved
# 12. Get Activity Log → See all changes
# 13. Close Ticket → Mark as completed
# 14. Get by Status (5) → See in closed list
#
# Expected: All operations return 200 OK with proper data

###

#########################################
### TICKET STATUS REFERENCE
#########################################

# Open = 1          (Just created, waiting for assignment)
# InProgress = 2    (Technician actively working on it)
# Resolved = 3      (Issue fixed, awaiting customer confirmation)
# Reopened = 4      (Customer said it's not fixed, reopened)
# Closed = 5        (Ticket completed and closed)

###

#########################################
### TICKET PRIORITY REFERENCE
#########################################

# Low = 1       (Can wait, no rush)
# Medium = 2    (Normal priority)
# High = 3      (Urgent, fix soon)
# Critical = 4  (Emergency, fix immediately)

###

#########################################
### IMPORTANT NOTES
#########################################

# 1. Always login first to get JWT token
# 2. Replace {ticket-id} with actual ticket ID from responses
# 3. Replace {comment-id} with actual comment ID
# 4. Replace {technician-id} with another user's ID
# 5. Comments require 5-5000 characters
# 6. Attachment URLs are optional (use null or omit)
# 7. Only comment author can delete their comments
# 8. Activity log is auto-generated (read-only)
# 9. Pagination: pageNumber starts at 1, pageSize default 10
# 10. All timestamps are in UTC

###
